  "requirements": [
    {
      "id": "REQ-707",
      "body": "The system shall generate a local Certificate Authority on first boot, persist private key + cert at `/cubeos/data/ca/`."
    },
    {
      "id": "REQ-708",
      "body": "The system shall issue a TLS certificate for `cubeos.cube` + every coreapp FQDN signed by the local CA."
    },
    {
      "id": "REQ-709",
      "body": "The system shall configure NPM (the reverse proxy) to serve the local-CA-signed cert for `cubeos.cube`."
    },
    {
      "id": "REQ-710",
      "body": "The system shall expose `GET /api/v1/security/ca-cert` returning the CA's public cert in PEM format."
    },
    {
      "id": "REQ-713",
      "body": "The system shall renew the cubeos.cube cert 30 days before expiry."
    },
    {
      "id": "REQ-714",
      "body": "The system shall expose `POST /api/v1/security/ca-cert/rotate` for operator-triggered CA rotation."
    },
    {
      "id": "REQ-715",
      "body": "When the CA is rotated, the system shall re-issue all dependent certs + restart NPM atomically."
    },
    {
      "id": "REQ-716",
      "body": "When the CA is rotated, the system shall log the rotation event to `/cubeos/data/audit.log`."
    }
  ],
