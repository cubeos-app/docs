  "requirements": [
    {
      "id": "REQ-711",
      "body": "When the operator first connects to `https://cubeos.cube`, the system shall present a \"Trust this CA\" landing page with download + per-OS install instructions."
    },
    {
      "id": "REQ-712",
      "body": "While the operator has not trusted the CA, the system shall NOT block dashboard access (graceful TLS warning)."
    },
    {
      "id": "REQ-717",
      "body": "The system shall provide a one-page guide at `https://cubeos.cube/trust-ca` covering: download the CA cert, install on macOS / Windows / Linux / iOS / Android."
    },
    {
      "id": "REQ-718",
      "body": "When the operator imports the CA + restarts the browser, the system shall serve `https://cubeos.cube` with no TLS warning."
    },
    {
      "id": "REQ-719",
      "body": "The system shall publish the local CA cert via mDNS as `_cubeos-ca._tcp` for auto-discovery."
    },
    {
      "id": "REQ-720",
      "body": "While the device is in `offline_hotspot` mode, the system shall continue serving mDNS announcements on the AP-managed interface."
    }
  ],
