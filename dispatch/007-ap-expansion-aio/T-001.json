  "requirements": [
    {
      "id": "REQ-700",
      "body": "While the active profile is `all_in_one`, the system shall display the managed-interface selector in Settings \u2192 Network."
    },
    {
      "id": "REQ-701",
      "body": "The system shall list every AP-capable interface (from spec/005) PLUS every wired Ethernet interface in the selector."
    },
    {
      "id": "REQ-702",
      "body": "When the operator picks a managed interface, the system shall persist it to the `network_modes.dhcp_managed_interface` column (schema v23+) and trigger the network-mode-switch workflow."
    },
    {
      "id": "REQ-703",
      "body": "While no managed interface is selected, the system shall NOT enable Pi-hole DHCP (Article VI gate stays armed)."
    },
    {
      "id": "REQ-704",
      "body": "When two WiFi adapters are present, the system shall allow operator to designate one as AP-managed and the other as uplink-client."
    },
    {
      "id": "REQ-705",
      "body": "The system shall NOT allow the same interface to be both AP-managed AND uplink-client (mutual exclusion in API + UI)."
    },
    {
      "id": "REQ-706",
      "body": "When the operator violates the mutual exclusion via API, the system shall reject with HTTP 409."
    }
  ],
