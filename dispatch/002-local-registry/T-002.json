  "requirements": [
    {
      "id": "REQ-207",
      "body": "The system shall provide a dashboard action to import a tar-archived image into the local registry from a USB stick or local file."
    },
    {
      "id": "REQ-208",
      "body": "When an imported image is added, the system shall record source filename and import timestamp to `/cubeos/data/registry/imports.log`."
    },
    {
      "id": "REQ-209",
      "body": "The system shall NOT delete imported images automatically."
    },
    {
      "id": "REQ-211",
      "body": "If a coreapp's compose file references an image not present in the local registry, then the system shall fail the deploy with an actionable error listing the missing image."
    },
    {
      "id": "REQ-215",
      "body": "The system shall expose `GET /api/v1/registry/status` returning storage usage, image count, last-import timestamp, last-GC timestamp."
    },
    {
      "id": "REQ-216",
      "body": "While the registry is unreachable, the dashboard shall display a critical-severity health banner blocking app-install actions."
    },
    {
      "id": "REQ-217",
      "body": "The system shall mirror the registry health into the `cubeos-cli system health` command output."
    }
  ],
