  "requirements": [
    {
      "id": "REQ-204",
      "body": "The system shall populate the local registry with all coreapp images at image-build time."
    },
    {
      "id": "REQ-210",
      "body": "While the system is in `offline_hotspot` mode, the system shall NOT attempt any pull from a remote registry."
    },
    {
      "id": "REQ-212",
      "body": "The system shall expose a dashboard action to garbage-collect untagged registry layers older than 30 days."
    },
    {
      "id": "REQ-213",
      "body": "When garbage collection runs, the system shall NOT delete any layer referenced by an actively-deployed stack."
    },
    {
      "id": "REQ-214",
      "body": "The system shall log every garbage-collection event to `/cubeos/data/registry/gc.log` with byte-reclaimed counts."
    }
  ],
