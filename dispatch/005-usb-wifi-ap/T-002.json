  "requirements": [
    {
      "id": "REQ-503",
      "body": "The system shall expose `GET /api/v1/network/ap-interfaces` returning the ordered list of AP-capable interfaces with metadata."
    },
    {
      "id": "REQ-504",
      "body": "The system shall expose `POST /api/v1/network/ap-interface` to set the active AP interface."
    },
    {
      "id": "REQ-505",
      "body": "When the operator picks a new AP interface, the system shall trigger a network-mode-switch workflow that re-deploys hostapd against the new interface."
    },
    {
      "id": "REQ-507",
      "body": "The system shall persist the operator-selected AP interface in SQLite (schema v28+)."
    },
    {
      "id": "REQ-508",
      "body": "When the system boots, the system shall read the persisted AP interface before launching hostapd."
    },
    {
      "id": "REQ-511",
      "body": "The system shall reference the chosen AP interface as `ap_interface` (role-based per Article VIII)."
    },
    {
      "id": "REQ-512",
      "body": "When the AP interface role is reassigned, the system shall update firewall rules + hostapd config + Pi-hole DHCP binding atomically."
    },
    {
      "id": "REQ-513",
      "body": "When upgrading from a pre-Phase-10 CubeOS, the system shall default `ap_interface` to the onboard Pi WiFi and prompt the operator to choose otherwise."
    },
    {
      "id": "REQ-515",
      "body": "The system shall expose `GET /api/v1/network/ap-status` returning active AP interface, mode, connected-client count, current TX power."
    }
  ],
