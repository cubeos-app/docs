  "requirements": [
    {
      "id": "REQ-400",
      "body": "The system shall provide exactly three access profiles: `standard`, `advanced`, `all_in_one`."
    },
    {
      "id": "REQ-401",
      "body": "The system shall set `standard` as the default profile on first-boot wizard completion."
    },
    {
      "id": "REQ-405",
      "body": "The system shall expose `POST /api/v1/access-profile/switch` taking `{profile: \"<name>\"}`."
    },
    {
      "id": "REQ-406",
      "body": "When the operator switches profile, the system shall trigger the `access_profile_switch` FlowEngine workflow at `api/internal/flowengine/workflows/access_profile_switch.go`."
    },
    {
      "id": "REQ-407",
      "body": "When the workflow runs, the system shall compose activities from `api/internal/flowengine/activities/access_profile.go` to: stop coreapps disabled by the new profile, start coreapps enabled by the new profile, and update firewall rules."
    },
    {
      "id": "REQ-408",
      "body": "If the workflow fails at any step, then the system shall run compensating actions to restore the prior profile state."
    },
    {
      "id": "REQ-409",
      "body": "The system shall persist the active profile in the SQLite `access_profiles` table (schema v21+)."
    },
    {
      "id": "REQ-410",
      "body": "When the system boots, the system shall read the persisted profile before deciding which coreapps to start."
    },
    {
      "id": "REQ-414",
      "body": "The system shall NOT enable Pi-hole DHCP under any profile other than `all_in_one`."
    },
    {
      "id": "REQ-415",
      "body": "If the operator attempts to enable DHCP via API while profile != `all_in_one`, then the system shall reject the request with HTTP 409."
    },
    {
      "id": "REQ-416",
      "body": "When the operator switches AWAY from `all_in_one`, the system shall stop Pi-hole DHCP cleanly without disrupting active leases (Pi-hole continues serving existing leases until renewal timeout)."
    },
    {
      "id": "REQ-417",
      "body": "The system shall NOT allow operator-defined custom profiles in v1.0 (`PRF-05` deferred)."
    },
    {
      "id": "REQ-418",
      "body": "When the API receives `POST /api/v1/access-profile/switch` with a profile name outside the canonical set, the system shall reject with HTTP 400."
    },
    {
      "id": "REQ-419",
      "body": "The system shall write a structured audit event to `/cubeos/data/audit.log` on every profile switch including: from-profile, to-profile, operator, timestamp."
    },
    {
      "id": "REQ-420",
      "body": "The system shall expose `GET /api/v1/access-profile/history` returning the last 100 profile changes."
    },
    {
      "id": "REQ-421",
      "body": "When the system upgrades from schema v20 to v21, the system shall create the `access_profiles` table and seed the existing device's profile as `standard`."
    },
    {
      "id": "REQ-422",
      "body": "When the system upgrades from schema v22 to v23, the system shall add the `dhcp_managed_interface` column to `network_modes`."
    },
    {
      "id": "REQ-423",
      "body": "The system shall NOT allow downgrading a profile-aware device back to a pre-v21 schema (Article XIII append-only)."
    }
  ],
