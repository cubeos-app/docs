  "requirements": [
    {
      "id": "REQ-606",
      "body": "The system shall document the BananaPi deferral decision in the platform-support matrix."
    },
    {
      "id": "REQ-607",
      "body": "While BananaPi is deferred, the system shall keep the Packer template skeleton in `releases/platforms/bananapi/` for community contributors."
    },
    {
      "id": "REQ-608",
      "body": "The system shall run platform regression suites on each release: Pi 5, Pi 4 (cross-build), x86_64 LXC, x86_64 physical via QEMU."
    },
    {
      "id": "REQ-609",
      "body": "If any platform regression fails, then the system shall block the release tag until investigated."
    },
    {
      "id": "REQ-610",
      "body": "The system shall publish a platform-support matrix at `cubeos.app/platforms` listing for each platform: status, tested versions, known issues, install path."
    },
    {
      "id": "REQ-611",
      "body": "When a platform is upgraded from Community to Supported, the system shall add it to the Pi-Imager-manifest variant set."
    },
    {
      "id": "REQ-612",
      "body": "The system shall document per-platform hardware-feature parity at `cubeos.app/platforms/<name>/hardware-features`."
    },
    {
      "id": "REQ-613",
      "body": "When a hardware feature is unavailable on a platform, the system shall hide the related dashboard UI (Article VII)."
    },
    {
      "id": "REQ-614",
      "body": "The system shall maintain `releases/CONTRIBUTING-platforms.md` describing how to add a new platform."
    },
    {
      "id": "REQ-615",
      "body": "When a community PR adds a new platform, the system shall require passing platform-regression artifacts before review acceptance."
    }
  ],
