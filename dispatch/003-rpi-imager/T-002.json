  "requirements": [
    {
      "id": "REQ-304",
      "body": "When the operator opens Raspberry Pi Imager and selects \"Other general-purpose OS \u2192 CubeOS\", the system manifest shall list every published image variant."
    },
    {
      "id": "REQ-305",
      "body": "The system shall present a human-readable name for each variant in the form \"CubeOS Pi 5 (full)\" and \"CubeOS Pi 5 (lite \u2014 no AI/ML)\" \u2014 one name per published variant."
    },
    {
      "id": "REQ-306",
      "body": "While the user is downloading, the Pi Imager shall verify the SHA-256 against the manifest entry and abort on mismatch."
    },
    {
      "id": "REQ-307",
      "body": "The system shall submit the canonical manifest URL `https://get.cubeos.app/pi-imager-manifest.json` to the Raspberry Pi Foundation for catalog inclusion."
    },
    {
      "id": "REQ-308",
      "body": "The system shall maintain backward compatibility on the canonical manifest URL \u2014 the URL path shall not change."
    },
    {
      "id": "REQ-311",
      "body": "The system shall sign the manifest with the CubeOS release key and publish the signature at `get.cubeos.app/pi-imager-manifest.json.sig`."
    },
    {
      "id": "REQ-312",
      "body": "When Pi Imager fetches the manifest, the Pi Imager shall verify the signature against the published CubeOS release pubkey if it supports manifest signatures."
    }
  ],
