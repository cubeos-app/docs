  "requirements": [
    {
      "id": "REQ-300",
      "body": "The system shall produce `pi-imager-manifest.json` on every successful Packer image build."
    },
    {
      "id": "REQ-301",
      "body": "The system shall include SHA-256 digest, image-size, release-date, release-notes-url, and download-URL in the manifest for each image variant."
    },
    {
      "id": "REQ-302",
      "body": "The system shall upload `pi-imager-manifest.json` to `get.cubeos.app/pi-imager-manifest.json` on every release."
    },
    {
      "id": "REQ-303",
      "body": "When a new image is published, the system shall verify the SHA-256 in the manifest matches the actual published artifact before exposing the new manifest version."
    },
    {
      "id": "REQ-309",
      "body": "The system shall publish Pi 5 full + Pi 5 lite + Pi 4 full + Pi 4 lite + x86_64 full image variants."
    },
    {
      "id": "REQ-310",
      "body": "The system shall compute SHA-256 of each published image and embed in the manifest."
    },
    {
      "id": "REQ-313",
      "body": "The system shall include a `release_notes_url` field in each manifest entry pointing at the GitLab release page."
    },
    {
      "id": "REQ-314",
      "body": "The system shall keep all historical image versions in the manifest for at least 12 months after release."
    },
    {
      "id": "REQ-315",
      "body": "When a version reaches end-of-life, the system shall mark its manifest entry with `eol: true` rather than deleting."
    }
  ],
