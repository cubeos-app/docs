    {
      "id": "REQ-806",
      "body": "The system shall surface mode-switch progress in the dashboard via WebSocket push within 15 seconds typical."
    },
    {
      "id": "REQ-814",
      "body": "When the operator selects `wifi_client` or `wifi_bridge`, the system shall provide a UI to scan for nearby SSIDs + connect with credentials."
    },
    {
      "id": "REQ-817",
      "body": "The system shall maintain a regression suite exercising every mode transition."
    },
    {
      "id": "REQ-818",
      "body": "When the regression suite runs, the system shall verify each end-state matches expected firewall rules + active services + Pi-hole DHCP state."
    },
    {
      "id": "REQ-819",
      "body": "The system shall display a mode-picker in the dashboard with each mode's icon, name, description, and hardware-requirement check status."
    },
    {
      "id": "REQ-820",
      "body": "While the current mode is in transition, the system shall display a progress indicator with per-step status."
    },
    {
      "id": "REQ-821",
      "body": "If a mode-switch fails, then the system shall display the failure step + log link + retry / revert buttons."
    }
