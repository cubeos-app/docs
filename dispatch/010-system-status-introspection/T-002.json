  "requirements": [
    {
      "id": "REQ-1003",
      "body": "The system shall expose `GET /api/v1/system/health` returning JSON of per-coreapp health + per-subsystem health."
    },
    {
      "id": "REQ-1004",
      "body": "When any subsystem reports `unhealthy`, the system shall include a `remediation` field with actionable next steps."
    },
    {
      "id": "REQ-1005",
      "body": "The system shall expose `GET /api/v1/system/health?expanded=true` returning per-check detail."
    },
    {
      "id": "REQ-1006",
      "body": "The system shall expose `GET /api/v1/system/stacks/{stack}/resources` returning CPU + memory + network IO per service replica."
    },
    {
      "id": "REQ-1008",
      "body": "The system shall expose `GET /api/v1/system/audit` paginated with `from`, `to`, `event_type`, `actor` filters."
    },
    {
      "id": "REQ-1009",
      "body": "While the audit log file is rotated, the system shall include the previous N rotated files in the search corpus (default 30 days)."
    },
    {
      "id": "REQ-1010",
      "body": "The system shall expose `GET /api/v1/system/boot/history` returning the last 50 boot summaries."
    }
  ],
