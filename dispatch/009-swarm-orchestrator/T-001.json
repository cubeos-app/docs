  "requirements": [
    {
      "id": "REQ-900",
      "body": "The system shall route every container lifecycle operation through the single Orchestrator at `api/internal/managers/orchestrator.go:27`."
    },
    {
      "id": "REQ-901",
      "body": "The system shall NOT permit any other code path to call Docker directly except via Orchestrator \u2192 DockerManager (`api/internal/managers/docker.go`) or SwarmManager (`api/internal/managers/swarm.go`)."
    },
    {
      "id": "REQ-902",
      "body": "The system shall delegate all Docker Swarm API calls to a single SwarmManager."
    },
    {
      "id": "REQ-903",
      "body": "The system shall use a single `apps` table as the source of truth for installed apps."
    },
    {
      "id": "REQ-904",
      "body": "The system shall start every coreapp + user app as a Docker Swarm service, NEVER as `docker run`."
    },
    {
      "id": "REQ-905",
      "body": "The system shall configure each service with `restart_policy: condition: any` so Swarm restarts on container failure."
    },
    {
      "id": "REQ-909",
      "body": "The system shall allocate user-app ports via the PortManager at `api/internal/managers/ports_new.go` with triple-source validation (DB + Swarm + HAL)."
    },
    {
      "id": "REQ-910",
      "body": "When a user app is uninstalled, the system shall release its port back to the available pool."
    },
    {
      "id": "REQ-911",
      "body": "The system shall fail an install with HTTP 409 if no port is available in the 6100-6999 range."
    },
    {
      "id": "REQ-915",
      "body": "The system shall apply `--task-history-limit 1` to Swarm to bound `tasks.db` memory (Article IV)."
    }
  ],
