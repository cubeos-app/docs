  "requirements": [
    {
      "id": "REQ-906",
      "body": "The system shall implement multi-step lifecycle operations as FlowEngine workflows in `api/internal/flowengine/workflows/` composed from activities in `api/internal/flowengine/activities/`."
    },
    {
      "id": "REQ-907",
      "body": "When any workflow step fails, the system shall execute compensating actions in reverse order from the failure point."
    },
    {
      "id": "REQ-908",
      "body": "The system shall provide at minimum these workflows (CGC-verified shipping): `appstore_install`, `appstore_remove`, `app_install`, `app_remove`, `network_mode_switch`, `access_profile_switch`, `first_boot_setup`, `backup`, `restore`, `registry_cache`, `system_update`, `wifi_client_switch`."
    },
    {
      "id": "REQ-912",
      "body": "The system shall transform CasaOS-compatible docker-compose.yml files into Swarm-compatible compose at install time via the activities at `api/internal/flowengine/activities/appstore.go` and `app_install.go` (NOT a single managers/compose.go file)."
    },
    {
      "id": "REQ-913",
      "body": "When the transformation encounters a feature unsupported in Swarm, the system shall reject the install with an actionable error."
    },
    {
      "id": "REQ-918",
      "body": "The system shall persist saga-run history to the `flowengine_runs` table (schema v22+)."
    },
    {
      "id": "REQ-919",
      "body": "While a workflow is running, the system shall emit per-step progress events that the dashboard subscribes to via WebSocket."
    },
    {
      "id": "REQ-920",
      "body": "The system shall handle context cancellation by propagating through to the workflow step that observes it."
    }
  ],
